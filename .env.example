# ============================================================
#  Plataforma de monitoreo Zabbix - variables de entorno
#  Copia este archivo a ".env" para personalizar:  cp .env.example .env
#  (Si no existe .env, docker-compose.yml usa estos mismos valores por defecto.)
#  Son credenciales de LABORATORIO: cambialas si lo expones fuera de tu maquina.
# ============================================================

# --- Versiones fijadas (verificadas en Docker Hub) ---
ZABBIX_VERSION=6.0.49          # Zabbix 6.0 LTS (server, web y agent2 oficial)
POSTGRES_VERSION=15-alpine     # Base de datos de Zabbix
MAILHOG_VERSION=v1.0.1

# --- Puertos publicados en el host ---
WEB_PORT=8080                  # Frontend Zabbix  -> http://localhost:8080
MAILHOG_UI_PORT=8025           # UI de Mailhog    -> http://localhost:8025

# --- Base de datos de Zabbix (PostgreSQL) ---
POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_db_pass

# --- Host monitoreado "DB" (MySQL) ---
MYSQL_ROOT_PASSWORD=root_lab_pass
ZBX_MONITOR_USER=zbx_monitor
ZBX_MONITOR_PASSWORD=zbx_monitor_pass

# --- Host monitoreado "FTP" (vsftpd) ---
FTP_USER=ftpuser
FTP_PASS=ftp_lab_pass

# --- Credenciales del frontend Zabbix usadas por el script de automatizacion ---
# (por defecto Zabbix crea Admin / zabbix)
ZBX_ADMIN_USER=Admin
ZBX_ADMIN_PASSWORD=zabbix
ALERT_EMAIL=admin@lab.local    # destinatario de las alertas (se leen en Mailhog)

# --- Zona horaria ---
TZ=America/Bogota
